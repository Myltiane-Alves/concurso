generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  exams        Exam[]
}

model Exam {
  id        String    @id @default(cuid())
  userId    String
  name      String
  organ     String?
  board     String?
  role      String?
  examDate  DateTime?
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Subject[]

  @@index([userId])
}

model Subject {
  id        String   @id @default(cuid())
  examId    String
  name      String
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics    Topic[]

  @@index([examId])
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Topic {
  id               String      @id @default(cuid())
  subjectId        String
  parentId         String?
  code             String?
  position         Int         @default(0)
  title            String
  description      String?
  status           TopicStatus @default(NOT_STARTED)
  priority         Int         @default(1)
  estimatedMinutes Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent   Topic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[] @relation("TopicTree")

  @@index([subjectId])
  @@index([parentId])
}