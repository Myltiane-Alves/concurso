# Supabase > botão "Connect" > aba "ORM" / "Connection string"

# Transaction pooler (porta 6543) - usada pela aplicação
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (porta 5432) - usada pelo Prisma para criar as tabelas
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
